# Copy to .env (git-ignored) and replace every value. docker compose refuses to start while any password is unset.
# Generate strong values, e.g.: openssl rand -base64 24 | tr -d '/+='   (avoid @ : / in READER_PASSWORD; it goes into a URL)
POSTGRES_PASSWORD=
LOADER_PASSWORD=
READER_PASSWORD=
# Host interface for published ports (127.0.0.1 = this machine only)
BIND_ADDR=127.0.0.1
PG_HOST_PORT=5432
# harvest.py / psql connect as the loader role
PGHOST=localhost
PGPORT=5432
PGDATABASE=sjrwmd
PGUSER=sjrwmd_loader
PGPASSWORD=${LOADER_PASSWORD}
